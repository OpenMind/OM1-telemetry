// Wire-compatible with builtin_interfaces/msg/Time as generated by ROS 2's
// rosidl_typesupport for rmw_cyclonedds — module nesting and the trailing
// `_` on type/struct names matter: they determine the DDS type name used
// for topic type matching against Go2/G1's ROS 2 publishers.
module builtin_interfaces {
  module msg {
    module dds_ {
      struct Time_ {
        int32 sec;
        uint32 nanosec;
      };
    };
  };
};
