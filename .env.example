# Copy this file to .env and fill in the values for this robot, then run
# `docker compose up -d --build`. .env is gitignored -- never commit it,
# it holds a real API key.

# Host directory recordings are written to (bind-mounted read/write).
RECORDINGS_DIR_HOST=./recordings

# See README.md's "Robot profile" section: go2 or g1.
ROBOT_TYPE=g1

# Leave OPENMIND_API_URL/OPENMIND_API_KEY unset to record locally without
# uploading.
OPENMIND_API_URL=https://api.openmind.com/api/core
OPENMIND_API_KEY=
